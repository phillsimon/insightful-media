---
import Layout from '../../layouts/Layout.astro';
import Video from '../../components/Video.astro';
import { ed, posts } from '../../lib/content';
export async function getStaticPaths() {
  return (await posts()).map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const file = `src/content/posts/${p.id}.json`;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Layout title={d.title} description={d.excerpt || undefined} image={d.hero?.src}>
  <article class="prose" data-item={file} data-item-type="post">
    <h2 {...ed(file, 'title')}>{d.title}</h2>
    <p class="post-meta">{fmt(d.date)}{d.tags.length > 0 && <> &middot; {d.tags.join(', ')}</>}</p>
    {d.hero?.src && <img class="post-hero" src={d.hero.src} alt={d.hero.alt} {...ed(file, 'hero', 'image')} />}
    {d.video && <div style="margin-bottom:28px"><Video video={d.video} title={d.title} edit={ed(file, 'video', 'video')} /></div>}
    <div class="rich" {...ed(file, 'bodyHtml', 'html')} set:html={d.bodyHtml} />
    <p style="margin-top:40px"><a href="/blog/">&larr; All posts</a></p>
  </article>
</Layout>
